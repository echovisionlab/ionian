{
  "name": "@echovisionlab/ionian",
  "version": "0.1.2",
  "description": "ThreeJS Collection Set",
  "main": "dist/ionian.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/ionian.js",
      "default": "./dist/ionian.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE.md",
    "THIRD_PARTY_NOTICES.md",
    "THIRD_PARTY_LICENSES"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite --host --open",
    "build": "tsc6 --noEmit && vite build",
    "build:types": "dts-bundle-generator --config ./dts-bundle-generator.config.cjs",
    "prepack": "pnpm run build && pnpm run build:types",
    "typecheck": "tsc6 --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "pack:smoke": "node scripts/package-smoke.mjs",
    "validate": "pnpm test:coverage && pnpm run pack:smoke",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/echovisionlab/ionian.git"
  },
  "keywords": [
    "threejs",
    "particles",
    "simulation"
  ],
  "author": "Echo Vision Lab",
  "license": "PolyForm-Noncommercial-1.0.0",
  "bugs": {
    "url": "https://github.com/echovisionlab/ionian/issues"
  },
  "homepage": "https://github.com/echovisionlab/ionian#readme",
  "engines": {
    "node": "24.19.0"
  },
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621",
  "peerDependencies": {
    "mitt": "^3.0.1",
    "three": ">=0.175.0 <0.186.0",
    "three-stdlib": ">=2.35.15 <3.0.0"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@types/node": "^26.1.2",
    "@types/stats.js": "^0.17.4",
    "@types/three": "^0.185.4",
    "@vitest/coverage-v8": "^4.1.10",
    "dts-bundle-generator": "^9.5.1",
    "lil-gui": "^0.21.0",
    "stats.js": "^0.17.0",
    "terser": "^5.49.2",
    "prettier": "^3.5.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
