{
  "name": "@echovisionlab/ionian",
  "version": "0.1.6",
  "description": "ThreeJS Collection Set",
  "main": "dist/ionian.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/ionian.js",
      "default": "./dist/ionian.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE.md",
    "THIRD_PARTY_NOTICES.md",
    "THIRD_PARTY_LICENSES"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite --host --open",
    "build": "tsc6 --noEmit && vite build",
    "build:types": "dts-bundle-generator --config ./dts-bundle-generator.config.cjs",
    "prepack": "pnpm run build && pnpm run build:types",
    "typecheck": "tsc6 --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "pack:smoke": "node scripts/package-smoke.mjs",
    "validate": "pnpm test:coverage && pnpm run pack:smoke",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/echovisionlab/ionian.git"
  },
  "keywords": [
    "threejs",
    "particles",
    "simulation"
  ],
  "author": "Echo Vision Lab",
  "license": "PolyForm-Noncommercial-1.0.0",
  "bugs": {
    "url": "https://github.com/echovisionlab/ionian/issues"
  },
  "homepage": "https://github.com/echovisionlab/ionian#readme",
  "engines": {
    "node": "24.21.0"
  },
  "packageManager": "pnpm@12.9.1+sha512.06b055fff5cd20dc12781de173ced3310ce0951bf2ec620211a16045d5444d5c93a663210764ef29a653a610459ba0368f0e74f84d80c54723cf95aae7bc0d6d",
  "peerDependencies": {
    "mitt": "^3.0.1",
    "three": ">=0.175.0 <0.187.0",
    "three-stdlib": ">=2.35.15 <3.0.0"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@types/node": "^24.19.1",
    "@types/stats.js": "^0.17.4",
    "@types/three": "^0.186.0",
    "@vitest/coverage-v8": "^5.0.3",
    "dts-bundle-generator": "^9.5.1",
    "lil-gui": "^0.21.0",
    "stats.js": "^0.17.0",
    "terser": "^5.51.2",
    "three": "^0.186.1",
    "three-stdlib": "^2.36.1",
    "prettier": "^3.9.9",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
